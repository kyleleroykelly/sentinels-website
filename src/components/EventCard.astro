---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { formatRange, eventTypeLabel } from '../lib/util';

interface Props {
  event: CollectionEntry<'events'>;
  compact?: boolean;
}

const { event, compact = false } = Astro.props;
const { data } = event;
const { Content } = await render(event);
const month = new Intl.DateTimeFormat('en-US', { month: 'short', timeZone: 'UTC' }).format(data.start);
const day = data.start.getUTCDate();
---

<article class:list={['event', { 'event--compact': compact }]}>
  <div class="event__date" aria-hidden="true">
    <span class="event__month">{month}</span>
    <span class="event__day">{day}</span>
  </div>
  <div class="event__body">
    <p class="event__type">{eventTypeLabel[data.type]}</p>
    <h3 class="event__title">
      {data.url ? <a href={data.url} rel="noopener">{data.title}</a> : data.title}
    </h3>
    <p class="event__meta">
      <span>{formatRange(data.start, data.end)}</span>
      {data.times && <span> · {data.times}</span>}
    </p>
    <p class="event__place">
      {data.venue}, {data.city}, {data.state}
    </p>
    {
      !compact && event.body && (
        <div class="event__desc">
          <Content />
        </div>
      )
    }
  </div>
</article>

<style>
  .event {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    box-shadow: var(--shadow);
  }
  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: #fff;
    border-radius: var(--radius);
    padding: 0.5rem 0;
    align-self: start;
    line-height: 1;
  }
  .event__month {
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
  }
  .event__day {
    font-family: var(--font-display);
    font-size: 2rem;
    margin-top: 0.2rem;
  }
  .event__type {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--rose);
  }
  .event__title {
    font-size: 1.5rem;
    margin: 0.1rem 0 0.3rem;
  }
  .event__title a {
    text-decoration: none;
  }
  .event__title a:hover {
    text-decoration: underline;
  }
  .event__meta,
  .event__place {
    margin: 0;
    color: var(--ink-soft);
  }
  .event__desc {
    margin-top: 0.75rem;
    font-size: 1.05rem;
  }
  .event__desc :global(p:last-child) {
    margin-bottom: 0;
  }
  .event--compact {
    padding: 1rem;
  }
  .event--compact .event__title {
    font-size: 1.3rem;
  }
</style>
