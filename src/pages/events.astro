---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { site } from '../data/site';
import { href, today, isoDate } from '../lib/util';

const now = today();
const all = await getCollection('events');
const upcoming = all
  .filter(({ data }) => (data.end ?? data.start) >= now)
  .sort((a, b) => a.data.start.getTime() - b.data.start.getTime());
const past = all
  .filter(({ data }) => (data.end ?? data.start) < now)
  .sort((a, b) => b.data.start.getTime() - a.data.start.getTime());

const byYear = new Map<number, typeof past>();
for (const e of past) {
  const y = e.data.start.getUTCFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), e]);
}

// schema.org markup so search engines can list upcoming events.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': upcoming.map(({ data }) => ({
    '@type': 'Event',
    name: `${site.name} at ${data.title}`,
    startDate: isoDate(data.start),
    endDate: isoDate(data.end ?? data.start),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: data.venue,
      address: { '@type': 'PostalAddress', addressLocality: data.city, addressRegion: data.state, addressCountry: 'US' },
    },
    performer: { '@type': 'PerformingGroup', name: site.name },
    ...(data.url ? { url: data.url } : {}),
  })),
};
---

<Base title="Events" description={`Upcoming appearances by The Sentinels of the Rose at faires, festivals, libraries, and schools in ${site.region}.`}>
  <Fragment slot="head">
    {upcoming.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </Fragment>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Calendar</p>
        <h1>Upcoming events</h1>
        <p>Dates and venues are PLACEHOLDERS until the real schedule is added. Come find us!</p>
      </div>
      {
        upcoming.length > 0 ? (
          <div class="event-list">
            {upcoming.map((event) => (
              <EventCard event={event} />
            ))}
          </div>
        ) : (
          <p>Nothing on the calendar right now. <a href={href('/book/')}>Book us</a> and change that.</p>
        )
      }
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="section section--paper">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Where we have been</p>
            <h2>Past appearances</h2>
          </div>
          {[...byYear.entries()].map(([year, events]) => (
            <div class="year">
              <h3 class="year__label">{year}</h3>
              <div class="event-list">
                {events.map((event) => (
                  <EventCard event={event} compact />
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .event-list {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .year {
    margin-bottom: 2rem;
  }
  .year__label {
    color: var(--gold);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.25rem;
    margin-bottom: 1rem;
  }
</style>
