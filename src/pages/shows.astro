---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/util';

const shows = (await getCollection('shows')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(shows.map((s) => render(s)));

const groups = [
  { id: 'faire', title: 'Faires and festivals', intro: 'PLACEHOLDER. Stage and arena shows built for a crowd.' },
  { id: 'library', title: 'Library programs', intro: 'PLACEHOLDER. Hands-on history for patrons of all ages.' },
  { id: 'school', title: 'School programs', intro: 'PLACEHOLDER. Living-history visits that fit a class period or an assembly.' },
  { id: 'private', title: 'Private events', intro: 'PLACEHOLDER. Weddings, birthdays, corporate events, and more.' },
] as const;
---

<Base title="Shows and Programs" description="Stage shows for renaissance faires and festivals, plus library and school presentations from The Sentinels of the Rose.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we offer</p>
        <h1>Shows and programs</h1>
        <p>
          PLACEHOLDER. Every booking is tailored to the venue. The shows below are our usual formats; mix and match,
          or tell us what you have in mind.
        </p>
      </div>

      {
        groups.map((g) => {
          const items = shows
            .map((s, i) => ({ s, Content: rendered[i].Content }))
            .filter(({ s }) => s.data.audience === g.id);
          if (items.length === 0) return null;
          return (
            <div class="show-group" id={g.id}>
              <h2>{g.title}</h2>
              <p class="show-group__intro">{g.intro}</p>
              <div class="grid grid--2">
                {items.map(({ s, Content }) => (
                  <article class="card show">
                    <h3>{s.data.title}</h3>
                    <p class="show__summary">{s.data.summary}</p>
                    <dl class="facts">
                      <dt>Length</dt>
                      <dd>{s.data.length}</dd>
                      <dt>Space</dt>
                      <dd>{s.data.space}</dd>
                      <dt>Setting</dt>
                      <dd>{s.data.setting}</dd>
                      <dt>Audience</dt>
                      <dd>{s.data.audienceSize}</dd>
                    </dl>
                    <div class="show__body">
                      <Content />
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })
      }

      <div class="rule" aria-hidden="true">&#10045;</div>

      <div class="pricing card">
        <h2>Pricing</h2>
        <p>
          Rates depend on the length of the show, the number of fighters, travel distance, and whether the event
          runs one day or several. Contact us for pricing and we will send a quote within a few days.
        </p>
        <a class="btn btn--rose" href={href('/book/')}>Contact us for pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .show-group {
    margin-bottom: 3rem;
    scroll-margin-top: 6rem;
  }
  .show-group__intro {
    color: var(--ink-soft);
    max-width: 40rem;
  }
  .show__summary {
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .show__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .pricing {
    max-width: 44rem;
  }
</style>
