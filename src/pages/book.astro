---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import { site } from '../data/site';
import { href } from '../lib/util';

const socials = site.socials.filter((s) => s.url);
---

<Base title="Book Us" description={`Request The Sentinels of the Rose for your faire, festival, library, school, or private event in ${site.region}.`}>
  <section class="section">
    <div class="container book">
      <div class="book__form">
        <p class="eyebrow">Gig requests</p>
        <h1>Book the Sentinels</h1>
        <p class="book__lead">
          Tell us about your event and we will get back to you within a few days. No obligation. Pricing is quoted
          per event; see <a href={href('/shows/')}>Shows and Programs</a> for what we offer.
        </p>
        <BookingForm />
      </div>

      <aside class="book__aside">
        <div class="card">
          <h3>What to expect</h3>
          <ul class="book__list">
            <li>PLACEHOLDER. We travel throughout {site.region}; farther by arrangement.</li>
            <li>PLACEHOLDER. Please book at least 4–6 weeks ahead for faires and 3 weeks for library or school visits.</li>
            <li>PLACEHOLDER. Outdoor shows need a roughly 30 by 30 foot area with a safe buffer to the audience.</li>
            <li>PLACEHOLDER. Indoor programs work in a gym, meeting room, or auditorium.</li>
            <li>PLACEHOLDER. We bring our own equipment. Insurance details on request.</li>
          </ul>
        </div>

        <div class="card">
          <h3>Other ways to reach us</h3>
          <p>
            Email <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
          {
            socials.length > 0 ? (
              <ul class="book__list">
                {socials.map((s) => (
                  <li>
                    <a href={s.url} rel="noopener">
                      {s.name}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="book__muted">Social links coming soon.</p>
            )
          }
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .book {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 960px) {
    .book {
      grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
    }
  }
  .book__lead {
    font-size: 1.2rem;
    color: var(--ink-soft);
    max-width: 40rem;
  }
  .book__aside {
    display: grid;
    gap: 1.5rem;
  }
  .book__list {
    padding-left: 1.2em;
    margin: 0;
  }
  .book__list li {
    margin-bottom: 0.5rem;
  }
  .book__muted {
    color: var(--muted);
    margin: 0;
  }
</style>
